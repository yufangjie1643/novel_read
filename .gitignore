# ---------- Dependencies ----------
node_modules/

# ---------- Build outputs ----------
# Rust / Cargo
target/

# Frontend
dist/
.vite/

# Tauri Android (also handled by src-tauri/gen/android/.gitignore)
src-tauri/gen/android/.gradle/
src-tauri/gen/android/**/build/
src-tauri/gen/android/app/src/main/jniLibs/**/*.so

# APK / signing artifacts
*.apk
*.aab
*.idsig

# Legacy Android source kept only as compatibility reference
old/

# ---------- Local toolchains (machine-specific, do NOT commit) ----------
# Project-local Android SDK / NDK / JDK / adb / scrcpy
.android-tools/
# Project-local LLVM toolchain
LLVM/
# Per-machine cargo config (contains absolute toolchain paths)
src-tauri/.cargo/

# ---------- Generated test / capture artifacts ----------
test-artifacts/

# ---------- Logs ----------
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example

# ---------- Agent / AI tooling caches (local-only) ----------
.claude/
.codegraph/
.agents/
adb-apk-debug-workflow/

# ---------- Editors / IDEs ----------
.idea/
.vscode/
*.iml
*.swp
*.swo

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini
